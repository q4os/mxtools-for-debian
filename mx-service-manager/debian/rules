#!/usr/bin/make -f
export QT_SELECT=6
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

override_dh_auto_configure:
	dh_auto_configure -- \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_EXPORT_COMPILE_COMMANDS=ON

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build/
	rm -f translations/*.qm

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

# Do not create package-private .dwz debug data.
override_dh_dwz:
	@:

override_dh_auto_test:
	# Tests available via -DBUILD_TESTS=ON (default OFF in Debian builds)

override_dh_auto_install:
	# debian/install stages the package files directly from the build tree.
	@:

%:
	dh $@ --buildsystem=cmake+ninja --no-automatic-dbgsym
